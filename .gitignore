/build
/build-xcode
/build-asan

# Fetched dependencies (Iris-Headers).  Pulled by CMake into a fixed path so
# tooling can find them; never part of this repository.
/.deps
.vscode
__pycache__/
.arbiter/

# Generated C++ — regenerated by generator/ from spec/*.json.
# generated_source/README.md is documentation, kept committed.
generated_source/*
!generated_source/README.md

# The future-versioning test fixture — derived at configure time from
# tests/fixtures/build_future_spec.py + spec/, gitignored like generated_source/.
tests/fixtures/future_versioning/

# Generated documentation — regenerated by generator/ from spec/*.json.
# generated_docs/README.md is documentation, kept committed.
generated_docs/*
!generated_docs/README.md
